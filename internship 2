#include <iostream>
#include <fstream>
#include <string>

using namespace std;

class BankAccount {
private:
    int accountNumber;
    string name;
    float balance;

public:
    // Create account
    void createAccount() {
        cout << "\nEnter Account Number: ";
        cin >> accountNumber;

        cin.ignore();

        cout << "Enter Customer Name: ";
        getline(cin, name);

        cout << "Enter Initial Balance: ";
        cin >> balance;

        saveToFile();

        cout << "\nAccount Created Successfully!\n";
    }

    // Deposit money
    void deposit() {
        float amount;
        cout << "\nEnter Deposit Amount: ";
        cin >> amount;

        balance += amount;

        updateFile();

        cout << "Amount Deposited Successfully!\n";
    }

    // Withdraw money
    void withdraw() {
        float amount;

        cout << "\nEnter Withdrawal Amount: ";
        cin >> amount;

        if (amount > balance) {
            cout << "Insufficient Balance!\n";
        } else {
            balance -= amount;
            updateFile();
            cout << "Withdrawal Successful!\n";
        }
    }

    // Display account details
    void display() {
        cout << "\nAccount Number : " << accountNumber;
        cout << "\nCustomer Name  : " << name;
        cout << "\nBalance        : " << balance << endl;
    }

    // Save new account
    void saveToFile() {
        ofstream file("bank.txt", ios::app);

        file << accountNumber << endl;
        file << name << endl;
        file << balance << endl;

        file.close();
    }

    // Load account from file
    bool searchAccount(int accNo) {
        ifstream file("bank.txt");

        while (file >> accountNumber) {
            file.ignore();

            getline(file, name);

            file >> balance;

            if (accountNumber == accNo) {
                file.close();
                return true;
            }
        }

        file.close();
        return false;
    }

    // Update file after deposit/withdraw
    void updateFile() {
        ifstream file("bank.txt");
        ofstream temp("temp.txt");

        int acc;
        string cname;
        float bal;

        while (file >> acc) {
            file.ignore();

            getline(file, cname);

            file >> bal;

            if (acc == accountNumber) {
                temp << accountNumber << endl;
                temp << name << endl;
                temp << balance << endl;
            } else {
                temp << acc << endl;
                temp << cname << endl;
                temp << bal << endl;
            }
        }

        file.close();
        temp.close();

        remove("bank.txt");
        rename("temp.txt", "bank.txt");
    }
};

int main() {
    BankAccount account;

    int choice, accNo;

    while (true) {
        cout << "\n====== BANK MANAGEMENT SYSTEM ======\n";
        cout << "1. Create Account\n";
        cout << "2. Deposit Money\n";
        cout << "3. Withdraw Money\n";
        cout << "4. Balance Inquiry\n";
        cout << "5. Exit\n";

        cout << "\nEnter Your Choice: ";
        cin >> choice;

        switch (choice) {

        case 1:
            account.createAccount();
            break;

        case 2:
            cout << "\nEnter Account Number: ";
            cin >> accNo;

            if (account.searchAccount(accNo)) {
                account.deposit();
            } else {
                cout << "Account Not Found!\n";
            }
            break;

        case 3:
            cout << "\nEnter Account Number: ";
            cin >> accNo;

            if (account.searchAccount(accNo)) {
                account.withdraw();
            } else {
                cout << "Account Not Found!\n";
            }
            break;

        case 4:
            cout << "\nEnter Account Number: ";
            cin >> accNo;

            if (account.searchAccount(accNo)) {
                account.display();
            } else {
                cout << "Account Not Found!\n";
            }
            break;

        case 5:
            cout << "\nThank You for Using Bank Management System!\n";
            return 0;

        default:
            cout << "\nInvalid Choice!\n";
        }
    }

    return 0;
}
